# ============================================================
# Core Bot Configuration (Required)
# ============================================================

# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_from_botfather

# Your Telegram user ID (get from @userinfobot)
ADMIN_ID=123456789

# ============================================================
# Webhook Configuration (Required for production, optional for polling)
# ============================================================

# Base URL where your bot is hosted (e.g., https://your-app.onrender.com)
WEBHOOK_BASE_URL=https://your-app.onrender.com

# Random secret string for webhook security
WEBHOOK_SECRET=your_random_secret

# Port for webhook server (defaults to 10000)
PORT=10000

# Set to any value when deploying on Render to enable webhook mode
RENDER=true

# ============================================================
# Alert Scripts Configuration (Required for GitHub Actions alerts)
# ============================================================

# Your personal chat ID for receiving alerts
TELEGRAM_CHAT_ID=123456789

# Comma-separated list of chat IDs for Epic Games free game alerts
EPIC_GAMES_CHAT_IDS=123456789,987654321

# Comma-separated list of chat IDs for Steam free game alerts
STEAM_GAMES_CHAT_IDS=123456789,987654321

# CoinGecko API key for Bitcoin price tracking
COINGECKO_API_KEY=your_coingecko_api_key

# ============================================================
# /today Command APIs (Optional but recommended)
# ============================================================

# Google Gemini API key for event ranking and content generation
GEMINI_API_KEY=your_gemini_api_key

# Gemini model to use (defaults to gemini-2.0-flash-exp)
GEMINI_MODEL=gemini-2.0-flash-exp

# TheSportsDB API key (defaults to free tier "123" if not set)
SPORTSDB_API_KEY=123

# TMDB (The Movie Database) API bearer token
TMDB_API_TOKEN=your_tmdb_bearer_token

# IGDB (Internet Game Database) credentials
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# ============================================================
# Expense Tracking (Optional, only if using /expense command)
# ============================================================

# Google Sheets spreadsheet ID for expense tracking
SPREADSHEET_ID=your_google_sheets_spreadsheet_id

# Google service account credentials JSON (as a single-line string)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# ============================================================
# Miscellaneous (Optional)
# ============================================================

# Timezone for /today command date formatting (defaults to Asia/Kolkata)
TIMEZONE=Asia/Kolkata
